*.py[cod]
*.so
.env
*.db
data/db/
data/images/sample/
data/reports/
checkpoints/
*.pt
*.pth
.venv/
venv/
*.egg-info/
dist/
build/
.DS_Store

# ICCE-Asia benchmark data and run artefacts (large, re-fetchable)
data/benchmarks/
data/cache/

# Checkpoints are ignored except the pairing heads themselves: at ~20k
# parameters they are 100 KB, and they are the weights the reported tables were
# computed with, so a rerun can be checked against them rather than trusted.
# Order matters: `checkpoints/` above excludes the directory, so git never
# descends into it and a file-level negation alone would be dead. Re-include the
# directory first, re-exclude its contents, then name the exceptions -- which
# also have to out-rank the global `*.pt`.
!data/checkpoints/
data/checkpoints/**
!data/checkpoints/*.pt
!data/checkpoints/*.history.json

# Run outputs: keep the numbers, drop what can be regenerated from them.
# Metrics, LaTeX tables and the raw generations are the paper's evidence and
# are small; graph databases and caches are neither.
results/**
!results/**/
!results/**/*.json
!results/**/*.tex
!results/**/*.jsonl

# Superseded: produced before the CC->CD scene fix, when every grounding
# condition received an empty context. The current code cannot reproduce those
# numbers, so keeping them would only invite someone to cite them.
results/pilot_levir_cc/

# Jupyter
.ipynb_checkpoints/
