# ============================================================
# MSIS Environment Configuration
# Copy to .env and adjust values for your environment
# ============================================================

# --- SAM2 Model ---
SAM2_MODEL_CFG=sam2_hiera_large.yaml
SAM2_CHECKPOINT=checkpoints/sam2_hiera_large.pt
SAM2_DEVICE=cuda

# --- CLIP ---
CLIP_MODEL_NAME=ViT-B/32

# --- LLM Backend: "huggingface" or "ollama" ---
LLM_BACKEND=huggingface

# -- HuggingFace EXAONE4-32b ---
LLM_MODEL_NAME=LGAI-EXAONE/EXAONE-4.0-32B-Instruct
LLM_DEVICE=cuda
LLM_MAX_NEW_TOKENS=2048
LLM_TEMPERATURE=0.2

# --- Ollama (alternative backend) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=exaone4:32b

# --- Detection ---
DETECTION_CONFIDENCE=0.30
NMS_IOU=0.50

# --- Coordinate matching radius (degrees) ---
COORD_MATCH_RADIUS=0.01

# --- Logging ---
LOG_LEVEL=INFO
